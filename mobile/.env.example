# Copy to .env and fill in. EXPO_PUBLIC_* vars are inlined into the JS
# bundle at build time (Expo's convention) — fine for a base URL and a
# public OAuth client ID, never put secrets here.

# Backend API base URL. On a physical device/emulator, "localhost" means
# the DEVICE itself, not your dev machine — use your machine's LAN IP
# instead, e.g. http://192.168.1.23:8001
EXPO_PUBLIC_API_URL=http://localhost:8001

# The "Web application" OAuth client ID from Google Cloud Console — the
# SAME one the backend verifies against (GOOGLE_OAUTH_CLIENT_ID in the
# root .env). GoogleSignin.configure() needs the web client ID specifically
# (not the Android/iOS one) to receive a verifiable idToken.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
