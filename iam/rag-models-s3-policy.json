{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListRagModelsBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::fitness-app-models-prod-2026",
      "Condition": {
        "StringLike": {
          "s3:prefix": "workout/*"
        }
      }
    },
    {
      "Sid": "ReadRagModelObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::fitness-app-models-prod-2026/workout/*"
    }
  ]
}
