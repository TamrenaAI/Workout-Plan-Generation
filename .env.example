AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tamrena

OPENAI_API_KEY=

# ── Auth ──────────────────────────────────────────────────────
# OAuth client ID from Google Cloud Console (Credentials > OAuth 2.0 Client
# IDs) — the mobile app signs in with Google using this same client ID, and
# the backend verifies ID tokens were issued for it.
GOOGLE_OAUTH_CLIENT_ID=
# Secret used to sign this backend's own session JWTs. Generate a long
# random value per environment (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
# — never reuse the same value across dev/staging/prod.
JWT_SECRET=
# Enables POST /auth/dev-login — mints a real session for a fixed test
# account with NO Google verification at all. Lets the mobile app be
# tested end-to-end (web preview, Expo Go) without a native Google
# Sign-In build. !! NEVER SET true ANYWHERE BUT A LOCAL DEV MACHINE !!
# Anyone with network access to a server with this enabled can sign in
# with no credential whatsoever.
ALLOW_DEV_LOGIN=false
