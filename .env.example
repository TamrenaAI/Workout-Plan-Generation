# ── DynamoDB ──────────────────────────────────────────────────────────
# This service's own 8 tables (one per former Mongo collection). All of
# these default to sensible values (see config.py) — only set them to
# override for a non-default environment (e.g. a second AWS account/region,
# or per-developer table names in a shared dev account).
AWS_REGION=eu-north-1
PLAN_SESSIONS_TABLE_NAME=workout_plan_sessions
EXERCISES_TABLE_NAME=workout_exercises
INBODY_SCANS_TABLE_NAME=workout_inbody_scans
WORKOUT_FEEDBACK_TABLE_NAME=workout_feedback_submissions
CORRECTIVE_RESULTS_TABLE_NAME=workout_corrective_results
PROGRESS_REPORTS_TABLE_NAME=workout_progress_reports
PLAN_ADJUSTMENTS_TABLE_NAME=workout_plan_adjustments
COACH_MESSAGES_TABLE_NAME=workout_coach_messages

# ── Google GenAI / Gemini Central Configuration ──────────────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemma-4-31b-it
MODEL_NAME=gemma-4-31b-it

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tamrena

OPENAI_API_KEY=

# ── ITI Bedrock proxy (alternate LLM path) ───────────────────────
# Used by agents/llm.py's get_llm() when wired to call the ITI Bedrock
# proxy (http://apiaccess.iti.net.eg/api/v1) instead of Azure/OpenAI directly.
SBG_API_KEY=

# ── Auth ──────────────────────────────────────────────────────
# This service verifies JWTs but no longer issues them — Google Sign-In
# and JWT issuance moved to the separate BFF repo (see
# docs/superpowers/specs/2026-07-25-bff-auth-handoff-design.md). This
# value MUST match that repo's JWT_SECRET exactly, or every request here
# will 401. Generate it once, share it with that repo's own .env — never
# reuse it across dev/staging/prod.
JWT_SECRET=

# ── RAG model cache (S3) ─────────────────────────────────────────
# docker-entrypoint.sh syncs s3://$RAG_MODELS_S3_BUCKET/$RAG_MODELS_S3_PREFIX
# into /app/data/models on container start (bge-m3, bge-reranker-v2-m3,
# fastembed). Leave RAG_MODELS_S3_BUCKET unset to skip the sync entirely
# (e.g. local dev where data/models/ is already populated on disk).
# See iam/rag-models-s3-policy.json for the least-privilege policy to
# attach to whatever identity runs this container.
RAG_MODELS_S3_BUCKET=
RAG_MODELS_S3_PREFIX=models
# Only needed if the container isn't running under an IAM role/instance
# profile that already has the policy below attached. Prefer a role over
# these when the deployment target supports it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
