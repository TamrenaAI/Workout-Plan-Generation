AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tamrena

OPENAI_API_KEY=

# ── ITI Bedrock proxy (alternate LLM path) ───────────────────────
# Used by agents/llm.py's get_llm() when wired to call the ITI Bedrock
# proxy (http://apiaccess.iti.net.eg/api/v1) instead of Azure/OpenAI directly.
SBG_API_KEY=

# ── Auth ──────────────────────────────────────────────────────
# OAuth client ID from Google Cloud Console (Credentials > OAuth 2.0 Client
# IDs) — the mobile app signs in with Google using this same client ID, and
# the backend verifies ID tokens were issued for it.
GOOGLE_OAUTH_CLIENT_ID=
# Secret used to sign this backend's own session JWTs. Generate a long
# random value per environment (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
# — never reuse the same value across dev/staging/prod.
JWT_SECRET=
# Enables POST /auth/dev-login — mints a real session for a fixed test
# account with NO Google verification at all. Lets the mobile app be
# tested end-to-end (web preview, Expo Go) without a native Google
# Sign-In build. !! NEVER SET true ANYWHERE BUT A LOCAL DEV MACHINE !!
# Anyone with network access to a server with this enabled can sign in
# with no credential whatsoever.
ALLOW_DEV_LOGIN=false

# ── RAG model cache (S3) ─────────────────────────────────────────
# docker-entrypoint.sh syncs s3://$RAG_MODELS_S3_BUCKET/$RAG_MODELS_S3_PREFIX
# into /app/data/models on container start (bge-m3, bge-reranker-v2-m3,
# fastembed). Leave RAG_MODELS_S3_BUCKET unset to skip the sync entirely
# (e.g. local dev where data/models/ is already populated on disk).
# See iam/rag-models-s3-policy.json for the least-privilege policy to
# attach to whatever identity runs this container.
RAG_MODELS_S3_BUCKET=
RAG_MODELS_S3_PREFIX=models
# Only needed if the container isn't running under an IAM role/instance
# profile that already has the policy below attached. Prefer a role over
# these when the deployment target supports it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
